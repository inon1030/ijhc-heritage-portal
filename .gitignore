# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# .env.example carries no secrets and belongs in the repo.
!.env.example

.vercel

# Security reports stay local.
.gstack/

# Playwright output
/test-results/
/playwright-report/

# Backups. Outside git deliberately: they hold contributor email addresses and
# scans of family material, and a backup committed to a repo is a leak waiting
# for the repo to be shared.
backups/
