# Supabase — create a NEW project for this app.
# Do not reuse the Bolt demo project: its RLS is wide open by design and this
# app assumes locked-down policies.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only. Never prefix with NEXT_PUBLIC_ and never commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI. Leave GEMINI_API_KEY empty to run the clearly-labelled simulator instead.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Force a provider. Omit to pick automatically: gemini when a key exists, else mock.
# AI_PROVIDER=mock

# Where a contributor writes to withdraw material or ask what is held about
# them. Shown in the handling notice at /handling and in the upload form.
# Until it is set, the notice says the address has not been published yet —
# which is honest, and better than pointing at a mailbox nobody reads.
# This one belongs to the Heritage Center; ask Erez for it.
NEXT_PUBLIC_ARCHIVE_CONTACT=

# The public address the archive is served from. Makes the share card's URLs
# absolute so a pasted link renders as a card rather than a bare URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── the nightly off-site backup ──────────────────────────────────────────────
# Any S3-compatible store: Cloudflare R2, Backblaze B2, AWS S3. Leave these
# unset and /api/cron/backup answers `configured: false` and does nothing —
# it never half-runs.
#
# For R2: endpoint is https://<account id>.r2.cloudflarestorage.com and the
# region is "auto". Create the bucket and an API token with Object Read & Write
# on that bucket only.
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_REGION=auto
BACKUP_S3_PREFIX=ijhc

# Set to `true` once billing is enabled on the Google Cloud project behind
# GEMINI_API_KEY. The key does not change; the limits rise, and — the reason
# this flag exists rather than being remembered about — the consent notice
# stops telling families not to send private material, and stamps a different
# CONSENT_VERSION so the two tiers are never confused for one another.
GEMINI_PAID_TIER=false
