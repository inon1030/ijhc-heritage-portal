{
  "name": "ijhc-heritage-portal",
  "version": "0.1.0",
  "private": true,
  "description": "Indian Jewish Heritage Center — Global Heritage Portal (Stage 1)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:push": "supabase db push",
    "db:reset": "supabase db reset",
    "db:seed": "tsx scripts/seed.ts",
    "db:reconcile": "tsx scripts/reconcile-files.ts",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "sync:vault": "node scripts/sync-vault.mjs --apply",
    "deploy": "node scripts/deploy.mjs",
    "public": "node scripts/serve-public.mjs",
    "db:backup": "tsx scripts/backup.ts",
    "db:backup:verify": "tsx scripts/backup.ts --verify",
    "test:db": "vitest run --config vitest.db.config.ts",
    "i18n": "node scripts/translate-ui.mjs"
  },
  "dependencies": {
    "@google/genai": "^1.34.0",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.95.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.549.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitest/coverage-v8": "^3.2.7",
    "dotenv": "^17.2.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "jsdom": "^28.0.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
